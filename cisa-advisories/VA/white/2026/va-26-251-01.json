  "vulnerabilities": [
    {
      "cve": "CVE-2026-81330",
      "cwe": {
        "id": "CWE-319",
        "name": "Cleartext Transmission of Sensitive Information"
      },
      "involvements": [
        {
          "date": "2026-07-14T06:00:00.000000Z",
          "party": "vendor",
          "status": "contact_attempted",
          "summary": "Vendor contact has been attempted."
        }
      ],
      "notes": [
        {
          "category": "summary",
          "text": "The C6 ear camera transmits live video to the EarVision Android application over unencrypted UDP streams. The application manifest permits cleartext traffic, and captured network traffic contains reconstructable JPEG or WEBP video frames transmitted over UDP. An attacker within local wireless range may capture and reconstruct the live video stream without transport encryption.",
          "title": "Vulnerability Summary"
        },
        {
          "category": "details",
          "text": "SSVCv2/E:N/A:N/2026-09-03T15:04:44.761552Z",
          "title": "SSVC"
        }
      ],
      "product_status": {
        "known_affected": [
          "CSAFPID-0001",
          "CSAFPID-0002"
        ]
      },
